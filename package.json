{
  "name": "pi-claude-directsdk",
  "version": "1.0.1",
  "type": "module",
  "description": "Claude as a Pi model provider through the unmodified Claude Code executable. Pi owns the transcript and tools; the CLI supplies subscription authentication as a model transport.",
  "license": "MIT",
  "author": "Joao Marcos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaomj/pi-claude-directsdk.git"
  },
  "homepage": "https://github.com/joaomj/pi-claude-directsdk#readme",
  "bugs": {
    "url": "https://github.com/joaomj/pi-claude-directsdk/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "claude",
    "claude-code",
    "model-provider"
  ],
  "files": [
    "extensions/**/*",
    "src/**/*",
    "docs/**/*",
    "README.md",
    "LICENSE",
    "scripts/smoke.mjs",
    "scripts/measure.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./extensions/claude-directsdk/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --disable-warning=DEP0205 --import ./tests/register.mjs --test \"tests/*.test.ts\"",
    "smoke": "node --experimental-strip-types --disable-warning=DEP0205 --import ./tests/register.mjs scripts/smoke.mjs",
    "measure": "node --experimental-strip-types --disable-warning=DEP0205 --import ./tests/register.mjs scripts/measure.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
